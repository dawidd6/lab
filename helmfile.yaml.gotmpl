# Renders the chart of every app; used for bootstrap (-l name=argocd / argocd-apps, Argo CD manages them afterwards) and PR diffs.
{{- $charts := list }}
{{- range $ns := readDirEntries "apps" }}
  {{- range readDirEntries (printf "apps/%s" $ns.Name) }}
    {{- $app := readFile (printf "apps/%s/%s/app.yaml" $ns.Name .Name) | fromYaml }}
    {{- $chart := index $app.spec.sources 0 }}
    {{- if hasKey $chart "chart" }}
      {{- $charts = append $charts (dict "name" $app.metadata.name "namespace" $ns.Name "source" $chart) }}
    {{- end }}
  {{- end }}
{{- end }}

repositories:
{{- range $charts }}
  {{- if contains "://" .source.repoURL }}
  - name: {{ .name }}
    url: {{ .source.repoURL }}
  {{- end }}
{{- end }}

releases:
{{- range $charts }}
  - name: {{ .name }}
    namespace: {{ .namespace }}
    # Argo CD takes OCI repos without a scheme
    chart: {{ if contains "://" .source.repoURL }}{{ .name }}{{ else }}oci://{{ .source.repoURL }}{{ end }}/{{ .source.chart }}
    version: {{ .source.targetRevision }}
    values:
      - {{ dig "helm" "valuesObject" dict .source | toJson }}
{{- end }}
