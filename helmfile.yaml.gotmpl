# Bootstrap only: renders Argo CD and its ApplicationSet from their app.yaml; Argo CD manages both afterwards.
{{- $apps := list "delivery/argocd" "delivery/argocd-apps" }}

repositories:
{{- range $apps }}
  {{- $app := readFile (printf "apps/%s/app.yaml" .) | fromYaml }}
  {{- $chart := index $app.spec.sources 0 }}
  - name: {{ $app.metadata.name }}
    url: {{ $chart.repoURL }}
{{- end }}

releases:
{{- range $apps }}
  {{- $app := readFile (printf "apps/%s/app.yaml" .) | fromYaml }}
  {{- $chart := index $app.spec.sources 0 }}
  - name: {{ $app.metadata.name }}
    namespace: {{ dir . }}
    chart: {{ $app.metadata.name }}/{{ $chart.chart }}
    version: {{ $chart.targetRevision }}
    values:
      - {{ $chart.helm.valuesObject | toJson }}
{{- end }}
