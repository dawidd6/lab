#!/usr/bin/env bash
#MISE description="Check that every app lists all its manifests, renders and matches the schemas"
set -euo pipefail

cd "$MISE_PROJECT_ROOT/kube/apps"

# custom resources' schemas; the CRDs themselves (from charts) have none and are skipped
crds='https://raw.githubusercontent.com/datreeio/CRDs-catalog/main/{{.Group}}/{{.ResourceKind}}_{{.ResourceAPIVersion}}.json'

status=0
for kustomization in */kustomization.yaml; do
  app=$(dirname "$kustomization")
  for file in "$app"/manifests/*.yaml; do
    [[ -e $file ]] || continue # no manifests/
    name=manifests/$(basename "$file")
    if ! name=$name yq -e '.resources[] | select(. == strenv(name))' "$kustomization" &>/dev/null; then
      echo "$app: $name is missing from resources"
      status=1
    fi
  done
  if ! kubectl kustomize --enable-helm "$app" |
    kubeconform -strict -skip CustomResourceDefinition -schema-location default -schema-location "$crds"; then
    echo "$app: does not render or validate"
    status=1
  fi
done
exit $status
