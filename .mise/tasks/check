#!/usr/bin/env bash
#MISE description="Scan for leaks, check secrets are encrypted and validate every app's files against the schemas"
set -euo pipefail

cd "$MISE_PROJECT_ROOT"

gitleaks git --redact --verbose --log-opts='--no-textconv --full-history --all'
gitleaks dir --redact --verbose .

shopt -s globstar
for f in apps/**/*.sops.yaml; do
  sops filestatus "$f" | grep -q '"encrypted":true' || {
    echo "not encrypted: $f"
    exit 1
  }
done

find apps -type f -name '*.yaml' -print0 | xargs -0 kubeconform \
  -strict \
  -summary \
  -verbose \
  -cache /tmp \
  -schema-location default \
  -schema-location 'https://raw.githubusercontent.com/datreeio/CRDs-catalog/main/{{.Group}}/{{.ResourceKind}}_{{.ResourceAPIVersion}}.json'
