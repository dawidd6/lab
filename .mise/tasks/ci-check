#!/usr/bin/env bash
#MISE description="Lint the Ansible playbooks, and validate every app's files against the schemas"
set -euo pipefail

cd "$MISE_PROJECT_ROOT/ansible"

ansible-lint -v

cd "$MISE_PROJECT_ROOT/kube"

find apps -type f -name '*.yaml' -print0 | xargs -0 kubeconform \
  -strict \
  -summary \
  -verbose \
  -cache /tmp \
  -schema-location default \
  -schema-location 'https://raw.githubusercontent.com/datreeio/CRDs-catalog/main/{{.Group}}/{{.ResourceKind}}_{{.ResourceAPIVersion}}.json'
