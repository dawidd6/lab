#!/usr/bin/env bash
#MISE description="Render every app's charts with its values/, and validate them and its files against the schemas"
set -euo pipefail

cd "$MISE_PROJECT_ROOT/ansible"

ansible-lint -v

cd "$MISE_PROJECT_ROOT/kube"

rendered="$(mktemp -d)"
for app in apps/*; do
  helm template charts/extra --values "$app/values/extra.yaml"
done >"$rendered/extra.yaml"

find apps "$rendered" -type f -wholename '*.yaml' -and -not -wholename '*/values/*' -print0 | xargs -0 kubeconform \
  -strict \
  -summary \
  -verbose \
  -cache /tmp \
  -schema-location default \
  -schema-location 'https://raw.githubusercontent.com/datreeio/CRDs-catalog/main/{{.Group}}/{{.ResourceKind}}_{{.ResourceAPIVersion}}.json'
