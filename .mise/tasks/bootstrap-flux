#!/usr/bin/env bash
#MISE description="Install Flux Operator and the FluxInstance for a cluster"
#USAGE arg "<cluster>" default="server"
set -euo pipefail

cd "$MISE_PROJECT_ROOT"

# shellcheck disable=SC2154
cluster="clusters/$usage_cluster"

kubectl apply --server-side -f base/gitops-system/namespace.yaml
kubectl -n gitops-system create secret generic sops-age \
    --from-file=age.agekey="$HOME/.config/sops/age/keys.txt" \
    --dry-run=client -o yaml | kubectl apply --server-side -f -

# the sync substitutes from these, so they must exist before its first run
sops -d "$cluster/cluster-secrets.sops.yaml" | kubectl apply --server-side -f -
kubectl apply --server-side -f "$cluster/cluster-vars.yaml"

helmfile sync --state-values-set cluster="$usage_cluster"
