#!/usr/bin/env bash
#MISE description="Install Argo CD and the root app (which then deploys everything)"
set -euo pipefail

cd "$MISE_PROJECT_ROOT/kube/apps"

if ! helm status -n argocd argocd &>/dev/null; then
  helm install argocd "$(yq '.spec.sources[0].chart' argocd/application.yaml)" \
    --repo "$(yq '.spec.sources[0].repoURL' argocd/application.yaml)" \
    --version "$(yq '.spec.sources[0].targetRevision' argocd/application.yaml)" \
    --values <(yq '.spec.sources[0].helm.valuesObject' argocd/application.yaml) \
    --namespace "$(yq '.spec.destination.namespace' argocd/application.yaml)" \
    --create-namespace \
    --wait
fi

if ! kubectl -n argocd get application root &>/dev/null; then
  kubectl create -f root/application.yaml
fi
