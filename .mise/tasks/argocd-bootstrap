#!/usr/bin/env bash
#MISE description="Apply the Infisical credentials, install Argo CD and the root app (which then deploys everything)"
set -euo pipefail

cd "$MISE_PROJECT_ROOT/kube/apps"

sops decrypt ../infisical.sops.yaml | kubectl apply --server-side -f -

if ! helm status -n argocd argocd &>/dev/null; then
  helm install argocd "$(yq '.spec.sources[0].chart' argocd/app.yaml)" \
    --repo "$(yq '.spec.sources[0].repoURL' argocd/app.yaml)" \
    --version "$(yq '.spec.sources[0].targetRevision' argocd/app.yaml)" \
    --values argocd/values.yaml \
    --namespace "$(yq '.spec.destination.namespace' argocd/app.yaml)" \
    --create-namespace \
    --wait
fi

if ! kubectl -n argocd get application root &>/dev/null; then
  kubectl create -f root/application.yaml
fi
