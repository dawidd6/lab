#!/usr/bin/env bash
#MISE description="Give the cluster the age key, install Argo CD and its ApplicationSet (which then deploys everything)"
set -euo pipefail

cd "$MISE_PROJECT_ROOT/kube/apps"

# the key sops-secrets-operator decrypts every *.sops.yaml with
if ! kubectl -n sops-secrets-operator get secret sops-age &>/dev/null; then
  kubectl create namespace sops-secrets-operator
  kubectl -n sops-secrets-operator create secret generic sops-age \
    --from-file=keys.txt="${SOPS_AGE_KEY_FILE:-$HOME/.config/sops/age/keys.txt}"
fi

if ! kubectl -n argocd get deployment argocd-server &>/dev/null; then
  yq '.spec.source.helm.valuesObject' argocd/app.yaml | helm install argocd "$(yq '.spec.source.chart' argocd/app.yaml)" \
    --repo "$(yq '.spec.source.repoURL' argocd/app.yaml)" \
    --version "$(yq '.spec.source.targetRevision' argocd/app.yaml)" \
    --values - \
    --namespace argocd \
    --create-namespace \
    --wait
fi

# the ApplicationSet (argocd-apps); it then generates every app, Argo CD's and its own included
if ! kubectl -n argocd get applicationset apps &>/dev/null; then
  yq '.spec.source.helm.valuesObject' argocd-apps/app.yaml | helm install argocd-apps "$(yq '.spec.source.chart' argocd-apps/app.yaml)" \
    --repo "$(yq '.spec.source.repoURL' argocd-apps/app.yaml)" \
    --version "$(yq '.spec.source.targetRevision' argocd-apps/app.yaml)" \
    --values - \
    --namespace argocd
fi

# Argo CD manages both from now on: drop Helm's release records (only those; the resources stay) so none goes stale
kubectl -n argocd delete secret --selector owner=helm --ignore-not-found
