#!/usr/bin/env bash
#MISE description="Give the cluster the age key, install Argo CD and the root app (which then deploys everything)"
set -euo pipefail

cd "$MISE_PROJECT_ROOT/kube/apps"

# the key sops-secrets-operator decrypts every *.sops.yaml with
if ! kubectl -n sops-secrets-operator get secret sops-age &>/dev/null; then
  kubectl create namespace sops-secrets-operator
  kubectl -n sops-secrets-operator create secret generic sops-age \
    --from-file=keys.txt="${SOPS_AGE_KEY_FILE:-$HOME/.config/sops/age/keys.txt}"
fi

if ! helm status -n argocd argocd &>/dev/null; then
  helm install argocd "$(yq '.spec.sources[0].chart' argocd/app.yaml)" \
    --repo "$(yq '.spec.sources[0].repoURL' argocd/app.yaml)" \
    --version "$(yq '.spec.sources[0].targetRevision' argocd/app.yaml)" \
    --values argocd/values.yaml \
    --namespace argocd \
    --create-namespace \
    --wait
fi

if ! kubectl -n argocd get application root &>/dev/null; then
  kubectl create -f root/application.yaml
fi
