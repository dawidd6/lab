#!/usr/bin/env bash
#MISE description="Install ArgoCD and Applications"
set -euo pipefail

cd "$MISE_PROJECT_ROOT"

kubectl create namespace secret --dry-run=client -o yaml | kubectl apply --server-side -f -
kubectl create namespace delivery --dry-run=client -o yaml | kubectl apply --server-side -f -

kubectl -n secret create secret generic sops-age --from-file=keys.txt="$HOME/.config/sops/age/keys.txt" --dry-run=client -o yaml | kubectl apply --server-side -f -

helmfile template -q | kubectl apply --server-side --field-manager=argocd-controller -n delivery -f -

kubectl -n delivery rollout status deploy/argocd-repo-server

kubectl apply --server-side --field-manager=argocd-controller -n delivery -f apps/delivery/root/manifests/applicationset.yaml
