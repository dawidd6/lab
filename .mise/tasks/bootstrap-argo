#!/usr/bin/env bash
#MISE description="Install ArgoCD and Applications"
set -euo pipefail

cd "$MISE_PROJECT_ROOT/apps"

kubectl create namespace "$(yq '.spec.destination.namespace' sops-secrets-operator/app.yaml)" --dry-run=client -o yaml | kubectl apply --server-side -f -
kubectl -n "$(yq '.spec.destination.namespace' sops-secrets-operator/app.yaml)" create secret generic "$(yq '.values.secretsAsFiles[0].secretName' sops-secrets-operator/app.yaml)" \
    --from-file="$(yq '.values.extraEnv[0].value | split("/") | .[-1]' sops-secrets-operator/app.yaml)=$HOME/.config/sops/age/keys.txt" \
    --dry-run=client -o yaml | kubectl apply --server-side -f -

for app in argocd argocd-apps; do
    kubectl create namespace "$(yq '.spec.destination.namespace' $app/app.yaml)" --dry-run=client -o yaml | kubectl apply --server-side -f -
    yq '.values' $app/app.yaml | helm template "$(yq '.metadata.name' $app/app.yaml)" "$(yq '.spec.source.chart' $app/app.yaml)" \
        --repo "$(yq '.spec.source.repoURL' $app/app.yaml)" \
        --version "$(yq '.spec.source.targetRevision' $app/app.yaml)" \
        --namespace "$(yq '.spec.destination.namespace' $app/app.yaml)" \
        --values - |
        kubectl apply --server-side --field-manager=argocd-controller --namespace "$(yq '.spec.destination.namespace' $app/app.yaml)" -f -
done
