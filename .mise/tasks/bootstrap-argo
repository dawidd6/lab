#!/usr/bin/env bash
#MISE description="Install ArgoCD and Applications"
set -euo pipefail

cd "$MISE_PROJECT_ROOT"

kubectl create namespace secrets-system --dry-run=client -o yaml | kubectl apply --server-side -f -
kubectl -n secrets-system create secret generic "$(yq '.values.secretsAsFiles[0].secretName' apps/secrets-system/sops-secrets-operator/app.yaml)" \
    --from-file="$(yq '.values.extraEnv[0].value | split("/") | .[-1]' apps/secrets-system/sops-secrets-operator/app.yaml)=$HOME/.config/sops/age/keys.txt" \
    --dry-run=client -o yaml | kubectl apply --server-side -f -

kubectl create namespace gitops-system --dry-run=client -o yaml | kubectl apply --server-side -f -
# separate applies: the ApplicationSet needs the CRD from the argocd release
helmfile template -q -l name=argocd | kubectl apply --server-side --field-manager=argocd-controller --namespace gitops-system -f -
helmfile template -q -l name=argocd-apps | kubectl apply --server-side --field-manager=argocd-controller --namespace gitops-system -f -
