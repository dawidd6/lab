      "title": "Inflation y/y",
      "description": "Eurostat HICP, annual rate of change, Poland (close to, not identical with, GUS CPI)",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "markets"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
