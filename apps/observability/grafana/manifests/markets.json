      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "markets"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "https://ec.europa.eu/eurostat/api/dissemination/statistics/1.0/data/prc_hicp_minr",
          "url_options": {
            "method": "GET",
            "params": [
              {
                "key": "geo",
                "value": "PL"
              },
              {
                "key": "unit",
                "value": "RCH_A"
              },
              {
                "key": "coicop18",
                "value": "TOTAL"
              },
              {
                "key": "lastTimePeriod",
                "value": "1"
              },
              {
                "key": "format",
                "value": "JSON"
              }
            ],
            "headers": []
          },
          "root_selector": "{\"period\": $keys(dimension.time.category.index)[0], \"value\": value.\"0\"}",
          "columns": [
            {
              "selector": "period",
              "text": "Month",
              "type": "string"
            },
            {
              "selector": "value",
              "text": "HICP",
              "type": "number"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "unit": "percent",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "graphMode": "none",
        "colorMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "wideLayout": true
