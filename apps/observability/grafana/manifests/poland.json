  "panels": [
    {
      "id": 14,
      "type": "stat",
      "title": "Inflation y/y",
      "description": "Eurostat HICP, annual rate of change, Poland (close to, not identical with, GUS CPI)",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "markets"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "markets"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "https://ec.europa.eu/eurostat/api/dissemination/statistics/1.0/data/prc_hicp_minr",
          "url_options": {
            "method": "GET",
            "params": [
              {
                "key": "geo",
                "value": "PL"
              },
              {
                "key": "unit",
                "value": "RCH_A"
              },
              {
                "key": "coicop18",
                "value": "TOTAL"
              },
              {
                "key": "lastTimePeriod",
                "value": "1"
              },
              {
                "key": "format",
                "value": "JSON"
              }
            ],
            "headers": []
          },
          "root_selector": "([{\"period\": $keys(dimension.time.category.index)[0], \"value\": $lookup(value, \"0\")}])",
          "columns": [
            {
              "selector": "period",
              "text": "Month",
              "type": "string"
            },
            {
              "selector": "value",
              "text": "HICP",
              "type": "number"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "unit": "percent",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "graphMode": "none",
        "colorMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "wideLayout": true
      }
    },
    {
      "id": 15,
      "type": "stat",
      "title": "NBP reference rate",
      "description": "Central bank policy rate for Poland, as published by BIS (weekly)",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "markets"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "markets"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "https://stats.bis.org/api/v1/data/WS_CBPOL/D.PL/all",
          "url_options": {
            "method": "GET",
            "params": [
              {
                "key": "lastNObservations",
                "value": "1"
              }
            ],
            "headers": [
              {
                "key": "Accept",
                "value": "application/vnd.sdmx.data+json;version=1.0.0"
              }
            ]
          },
          "root_selector": "([{\"date\": data.structure.dimensions.observation[0].values[0].id, \"rate\": $number($lookup($lookup(data.dataSets[0].series, \"0:0\").observations, \"0\")[0])}])",
          "columns": [
            {
              "selector": "date",
              "text": "As of",
              "type": "string"
            },
            {
              "selector": "rate",
              "text": "Rate",
              "type": "number"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "unit": "percent",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "graphMode": "none",
        "colorMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "wideLayout": true
      }
    }
  ]
}
