{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:daily"
  ],
  "argocd": {
    "managerFilePatterns": [
      "/\\.yaml$/"
    ]
  },
  "packageRules": [
    {
      "description": "charts are pinned without v (cert-manager tags its chart with v)",
      "matchManagers": [
        "argocd"
      ],
      "extractVersion": "^v?(?<version>.*)$"
    }
  ]
}
