{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "argocd": {
    "managerFilePatterns": ["/\\.yaml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/\\.yaml$/"]
  },
  "helm-values": {
    "managerFilePatterns": ["/\\.yaml$/"]
  },
  "packageRules": [
    {
      "description": "charts are pinned without v (cert-manager tags its chart with v)",
      "matchManagers": ["argocd"],
      "extractVersion": "^v?(?<version>.*)$"
    },
    {
      "description": "ansible-core supports Python only up to 3.14",
      "matchManagers": ["mise"],
      "matchDepNames": ["python"],
      "allowedVersions": "<3.15"
    }
  ]
}
